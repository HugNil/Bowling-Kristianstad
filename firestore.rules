rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function editor() {
      return request.auth != null
        && request.auth.token.auth_time is int
        && request.time.toMillis() < (request.auth.token.auth_time + 3600) * 1000
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Admin membership is managed only in Firebase Console / trusted administrative tooling.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /site/content {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if editor()
        && request.resource.data.keys().hasOnly(['payload', 'revision', 'updatedAt'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 200000
        && request.resource.data.revision is int
        && request.resource.data.updatedAt == request.time
        && ((!exists(/databases/$(database)/documents/site/content) && request.resource.data.revision == 1)
          || (exists(/databases/$(database)/documents/site/content) && request.resource.data.revision == resource.data.revision + 1));
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
